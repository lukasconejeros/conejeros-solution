    {
      "parameters": {
        "rules": {
          "values": [
            {
              "conditions": {
                "options": { "caseSensitive": false, "leftValue": "", "typeValidation": "strict" },
                "combinator": "and",
                "conditions": [{ "leftValue": "={{ $json.body.type }}", "rightValue": "lead_capture", "operator": { "type": "string", "operation": "equals" } }]
              },
              "output": 0
            },
            {
              "conditions": {
                "options": { "caseSensitive": false, "leftValue": "", "typeValidation": "strict" },
                "combinator": "and",
                "conditions": [{ "leftValue": "={{ $json.body.type }}", "rightValue": "chat_message", "operator": { "type": "string", "operation": "equals" } }]
              },
              "output": 1
            },
            {
              "conditions": {
                "options": { "caseSensitive": false, "leftValue": "", "typeValidation": "strict" },
                "combinator": "and",
                "conditions": [{ "leftValue": "={{ $json.body.type }}", "rightValue": "call_start", "operator": { "type": "string", "operation": "equals" } }]
              },
              "output": 2
            },
            {
              "conditions": {
                "options": { "caseSensitive": false, "leftValue": "", "typeValidation": "strict" },
                "combinator": "and",
                "conditions": [{ "leftValue": "={{ $json.body.type }}", "rightValue": "call_end", "operator": { "type": "string", "operation": "equals" } }]
              },
              "output": 3
            },
            {
              "conditions": {
                "options": { "caseSensitive": false, "leftValue": "", "typeValidation": "strict" },
                "combinator": "and",
                "conditions": [{ "leftValue": "={{ $json.body.type }}", "rightValue": "agenda_booking", "operator": { "type": "string", "operation": "equals" } }]
              },
              "output": 4
            },
            {
              "conditions": {
                "options": { "caseSensitive": false, "leftValue": "", "typeValidation": "strict" },
                "combinator": "and",
                "conditions": [{ "leftValue": "={{ $json.body.type }}", "rightValue": "demo_nav", "operator": { "type": "string", "operation": "equals" } }]
              },
              "output": 5
            }
          ]
        },
        "fallbackOutput": 6
      },
