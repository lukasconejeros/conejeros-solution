            { "id": "dn1", "name": "evento",    "value": "demo_nav",                                                                           "type": "string" },
            { "id": "dn2", "name": "target",    "value": "={{ $('📡 Recibir Evento').item.json.body.target }}",                                "type": "string" },
            { "id": "dn3", "name": "sessionId", "value": "={{ $('📡 Recibir Evento').item.json.body.sessionId }}",                             "type": "string" },
            { "id": "dn4", "name": "timestamp", "value": "={{ $('📡 Recibir Evento').item.json.body.timestamp || new Date().toISOString() }}", "type": "string" }
