{
  "name": "Orion.ia — Hub de Eventos Web",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "orion-hub",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "a1b2c3d4-0001-0001-0001-000000000001",
      "name": "📡 Recibir Evento",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [240, 300],
      "webhookId": "orion-hub"
    },
    {
      "parameters": {
        "rules": {
          "values": [
            {
              "conditions": {
                "options": { "caseSensitive": false, "leftValue": "", "typeValidation": "strict" },
                "combinator": "and",
                "conditions": [{ "leftValue": "={{ $json.body.type }}", "rightValue": "lead_capture", "operator": { "type": "string", "operation": "equals" } }]
              },
              "output": 0
            },
            {
              "conditions": {
                "options": { "caseSensitive": false, "leftValue": "", "typeValidation": "strict" },
                "combinator": "and",
                "conditions": [{ "leftValue": "={{ $json.body.type }}", "rightValue": "chat_message", "operator": { "type": "string", "operation": "equals" } }]
              },
              "output": 1
            },
            {
              "conditions": {
                "options": { "caseSensitive": false, "leftValue": "", "typeValidation": "strict" },
                "combinator": "and",
                "conditions": [{ "leftValue": "={{ $json.body.type }}", "rightValue": "call_start", "operator": { "type": "string", "operation": "equals" } }]
              },
              "output": 2
            },
            {
              "conditions": {
                "options": { "caseSensitive": false, "leftValue": "", "typeValidation": "strict" },
                "combinator": "and",
                "conditions": [{ "leftValue": "={{ $json.body.type }}", "rightValue": "call_end", "operator": { "type": "string", "operation": "equals" } }]
              },
              "output": 3
            },
            {
              "conditions": {
                "options": { "caseSensitive": false, "leftValue": "", "typeValidation": "strict" },
                "combinator": "and",
                "conditions": [{ "leftValue": "={{ $json.body.type }}", "rightValue": "agenda_booking", "operator": { "type": "string", "operation": "equals" } }]
              },
              "output": 4
            },
            {
              "conditions": {
                "options": { "caseSensitive": false, "leftValue": "", "typeValidation": "strict" },
                "combinator": "and",
                "conditions": [{ "leftValue": "={{ $json.body.type }}", "rightValue": "demo_nav", "operator": { "type": "string", "operation": "equals" } }]
              },
              "output": 5
            }
          ]
        },
        "fallbackOutput": 6
      },
      "id": "a1b2c3d4-0002-0002-0002-000000000002",
      "name": "🔀 Router por Tipo",
      "type": "n8n-nodes-base.switch",
      "typeVersion": 3,
      "position": [480, 300]
    },

    {
      "parameters": {
        "assignments": {
          "assignments": [
            { "id": "f1", "name": "evento",    "value": "lead_capture",                                                                        "type": "string" },
            { "id": "f2", "name": "nombre",    "value": "={{ $('📡 Recibir Evento').item.json.body.nombre }}",                                 "type": "string" },
            { "id": "f3", "name": "email",     "value": "={{ $('📡 Recibir Evento').item.json.body.email }}",                                  "type": "string" },
            { "id": "f4", "name": "telefono",  "value": "={{ $('📡 Recibir Evento').item.json.body.telefono || '' }}",                         "type": "string" },
            { "id": "f5", "name": "sessionId", "value": "={{ $('📡 Recibir Evento').item.json.body.sessionId }}",                              "type": "string" },
            { "id": "f6", "name": "timestamp", "value": "={{ $('📡 Recibir Evento').item.json.body.timestamp || new Date().toISOString() }}", "type": "string" }
          ]
        },
        "options": {}
      },
      "id": "a1b2c3d4-0010-0010-0010-000000000010",
      "name": "📋 Datos Lead",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [720, 60]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={ \"ok\": true, \"event\": \"lead_capture\", \"message\": \"Lead registrado correctamente\" }",
        "options": { "responseCode": 200 }
      },
      "id": "a1b2c3d4-0011-0011-0011-000000000011",
      "name": "✅ OK Lead",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [960, 60]
    },
    {
      "parameters": {
        "amount": 1,
        "unit": "minutes"
      },
      "id": "a1b2c3d4-0012-0012-0012-000000000012",
      "name": "⏳ Esperar 1 Min",
      "type": "n8n-nodes-base.wait",
      "typeVersion": 1.1,
      "position": [1200, 60],
      "webhookId": "orion-wait-lead-demo"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://TU_WHATSAPP_API_URL/send",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "Authorization", "value": "Bearer TU_API_KEY_WHATSAPP" },
            { "name": "Content-Type",  "value": "application/json" }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"phone\": \"{{ $json.telefono.toString().replace(/[^0-9]/g,'') }}\",\n  \"message\": \"Hola {{ $json.nombre }}! 👋 Vi que ocupaste nuestra demo de agente de IA de chat. ¿Cómo va el negocio? ¿Has estado pensando en añadir un agente de IA? Reducción de saturación de tu secretaria, menos tiempo de espera y más clientes atendidos. ¡Conversemos! 🚀\"\n}",
        "options": {}
      },
      "id": "a1b2c3d4-0013-0013-0013-000000000013",
      "name": "📱 WhatsApp Demo",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1440, 60]
    },
    {
      "parameters": {
        "operation": "create",
        "base": {
          "__rl": true,
          "value": "REEMPLAZA_CON_AIRTABLE_BASE_ID",
          "mode": "id"
        },
        "table": {
          "__rl": true,
          "value": "Clientes Potenciales",
          "mode": "name"
        },
        "columns": {
          "mappingMode": "defineBelow",
          "value": {
            "Nombre":           "={{ $json.nombre }}",
            "Email":            "={{ $json.email }}",
            "Teléfono":         "={{ $json.telefono }}",
            "Tipo":             "Demo Web",
            "Fecha":            "={{ new Date().toISOString().split('T')[0] }}",
            "Session ID":       "={{ $json.sessionId }}"
          },
          "matchingColumns": [],
          "schema": []
        },
        "options": {}
      },
      "credentials": {
        "airtableTokenApi": {
          "id": "REEMPLAZA_CON_ID_CREDENCIAL_AIRTABLE",
          "name": "Airtable account"
        }
      },
      "id": "a1b2c3d4-0014-0014-0014-000000000014",
      "name": "📊 Airtable — Demo",
      "type": "n8n-nodes-base.airtable",
      "typeVersion": 2,
      "position": [1680, 60]
    },

    {
      "parameters": {
        "assignments": {
          "assignments": [
            { "id": "c1", "name": "evento",    "value": "chat_message",                                                                        "type": "string" },
            { "id": "c2", "name": "message",   "value": "={{ $('📡 Recibir Evento').item.json.body.message }}",                                "type": "string" },
            { "id": "c3", "name": "sessionId", "value": "={{ $('📡 Recibir Evento').item.json.body.sessionId }}",                              "type": "string" },
            { "id": "c4", "name": "timestamp", "value": "={{ $('📡 Recibir Evento').item.json.body.timestamp || new Date().toISOString() }}", "type": "string" }
          ]
        },
        "options": {}
      },
      "id": "a1b2c3d4-0020-0020-0020-000000000020",
      "name": "💬 Datos Chat",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [720, 180]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={ \"ok\": true, \"event\": \"chat_message\", \"output\": \"Gracias por tu mensaje. Un agente te responderá en breve.\" }",
        "options": { "responseCode": 200 }
      },
      "id": "a1b2c3d4-0021-0021-0021-000000000021",
      "name": "✅ OK Chat",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [960, 180]
    },

    {
      "parameters": {
        "assignments": {
          "assignments": [
            { "id": "cs1", "name": "evento",    "value": "call_start",                                                                         "type": "string" },
            { "id": "cs2", "name": "sessionId", "value": "={{ $('📡 Recibir Evento').item.json.body.sessionId }}",                              "type": "string" },
            { "id": "cs3", "name": "assistant", "value": "={{ $('📡 Recibir Evento').item.json.body.assistant }}",                              "type": "string" },
            { "id": "cs4", "name": "timestamp", "value": "={{ $('📡 Recibir Evento').item.json.body.timestamp || new Date().toISOString() }}", "type": "string" }
          ]
        },
        "options": {}
      },
      "id": "a1b2c3d4-0030-0030-0030-000000000030",
      "name": "📞 Datos Llamada Inicio",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [720, 300]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={ \"ok\": true, \"event\": \"call_start\" }",
        "options": { "responseCode": 200 }
      },
      "id": "a1b2c3d4-0031-0031-0031-000000000031",
      "name": "✅ OK Llamada Inicio",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [960, 300]
    },

    {
      "parameters": {
        "assignments": {
          "assignments": [
            { "id": "ce1", "name": "evento",           "value": "call_end",                                                                         "type": "string" },
            { "id": "ce2", "name": "sessionId",        "value": "={{ $('📡 Recibir Evento').item.json.body.sessionId }}",                             "type": "string" },
            { "id": "ce3", "name": "duration_seconds", "value": "={{ $('📡 Recibir Evento').item.json.body.duration_seconds }}",                       "type": "number" },
            { "id": "ce4", "name": "timestamp",        "value": "={{ $('📡 Recibir Evento').item.json.body.timestamp || new Date().toISOString() }}", "type": "string" }
          ]
        },
        "options": {}
      },
      "id": "a1b2c3d4-0040-0040-0040-000000000040",
      "name": "📞 Datos Llamada Fin",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [720, 420]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={ \"ok\": true, \"event\": \"call_end\" }",
        "options": { "responseCode": 200 }
      },
      "id": "a1b2c3d4-0041-0041-0041-000000000041",
      "name": "✅ OK Llamada Fin",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [960, 420]
    },

    {
      "parameters": {
        "assignments": {
          "assignments": [
            { "id": "ab1",  "name": "evento",       "value": "agenda_booking",                                                                                                                  "type": "string" },
            { "id": "ab2",  "name": "nombre",       "value": "={{ $('📡 Recibir Evento').item.json.body.nombre }}",                                                                             "type": "string" },
            { "id": "ab3",  "name": "email",        "value": "={{ $('📡 Recibir Evento').item.json.body.email }}",                                                                              "type": "string" },
            { "id": "ab4",  "name": "empresa",      "value": "={{ $('📡 Recibir Evento').item.json.body.empresa || 'N/A' }}",                                                                   "type": "string" },
            { "id": "ab5",  "name": "whatsapp",     "value": "={{ $('📡 Recibir Evento').item.json.body.whatsapp || '' }}",                                                                     "type": "string" },
            { "id": "ab6",  "name": "plan",         "value": "={{ $('📡 Recibir Evento').item.json.body.plan || 'General' }}",                                                                  "type": "string" },
            { "id": "ab7",  "name": "fecha",        "value": "={{ $('📡 Recibir Evento').item.json.body.fecha }}",                                                                              "type": "string" },
            { "id": "ab8",  "name": "hora",         "value": "={{ $('📡 Recibir Evento').item.json.body.hora }}",                                                                               "type": "string" },
            { "id": "ab9",  "name": "hora_fin",     "value": "={{ $('📡 Recibir Evento').item.json.body.hora_fin || '' }}",                                                                     "type": "string" },
            { "id": "ab10", "name": "fecha_label",  "value": "={{ $('📡 Recibir Evento').item.json.body.fecha_label || $('📡 Recibir Evento').item.json.body.fecha }}",                         "type": "string" },
            { "id": "ab11", "name": "hora_label",   "value": "={{ $('📡 Recibir Evento').item.json.body.hora_label || $('📡 Recibir Evento').item.json.body.hora }}",                           "type": "string" },
            { "id": "ab12", "name": "startISO",     "value": "={{ $('📡 Recibir Evento').item.json.body.fecha + 'T' + $('📡 Recibir Evento').item.json.body.hora + ':00' }}",                   "type": "string" },
            { "id": "ab13", "name": "endISO",       "value": "={{ $('📡 Recibir Evento').item.json.body.hora_fin ? $('📡 Recibir Evento').item.json.body.fecha + 'T' + $('📡 Recibir Evento').item.json.body.hora_fin + ':00' : $('📡 Recibir Evento').item.json.body.fecha + 'T' + $('📡 Recibir Evento').item.json.body.hora + ':00' }}", "type": "string" },
            { "id": "ab14", "name": "sessionId",    "value": "={{ $('📡 Recibir Evento').item.json.body.sessionId || '' }}",                                                                    "type": "string" }
          ]
        },
        "options": {}
      },
      "id": "a1b2c3d4-0050-0050-0050-000000000050",
      "name": "📅 Datos Reserva",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [720, 540]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={ \"ok\": true, \"event\": \"agenda_booking\", \"message\": \"Reserva confirmada\" }",
        "options": { "responseCode": 200 }
      },
      "id": "a1b2c3d4-0051-0051-0051-000000000051",
      "name": "✅ OK Reserva",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [960, 540]
    },
    {
      "parameters": {
        "calendarId": { "__rl": true, "value": "primary", "mode": "list", "cachedResultName": "primary" },
        "start": "={{ $json.startISO }}",
        "end":   "={{ $json.endISO }}",
        "useDefaultReminders": true,
        "additionalFields": {
          "summary":     "={{ 'Reunión Orion.ia — ' + $json.nombre }}",
          "description": "={{ 'Nombre: ' + $json.nombre + '\\nEmail: ' + $json.email + '\\nWhatsApp: ' + $json.whatsapp + '\\nEmpresa: ' + $json.empresa + '\\nPlan: ' + $json.plan + '\\nFecha: ' + $json.fecha_label + '\\nHorario: ' + $json.hora_label }}"
        }
      },
      "credentials": {
        "googleCalendarOAuth2Api": {
          "id": "REEMPLAZA_CON_ID_CREDENCIAL_GCAL",
          "name": "Google Calendar account"
        }
      },
