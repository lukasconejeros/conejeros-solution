{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    {
      "source": "/",
      "has": [
        { "type": "header", "key": "accept", "value": ".*text/markdown.*" }
      ],
      "destination": "/index.md",
      "permanent": false
    }
  ],
  "rewrites": [
    { "source": "/index.md", "destination": "/llms.txt" }
  ],
  "headers": [
    {
      "source": "/index.md",
      "headers": [
        { "key": "Content-Type", "value": "text/markdown; charset=utf-8" }
      ]
    },
    {
      "source": "/llms.txt",
      "headers": [
        { "key": "Content-Type", "value": "text/markdown; charset=utf-8" }
      ]
    },
    {
      "source": "/",
      "headers": [
        {
          "key": "Link",
          "value": "</llms.txt>; rel=\"alternate\"; type=\"text/markdown\"; title=\"Resumen para agentes de IA\", </index.md>; rel=\"alternate\"; type=\"text/markdown\"; title=\"Home en markdown\", </sitemap.xml>; rel=\"sitemap\"; type=\"application/xml\", <https://www.conejeros-solutions.cl/>; rel=\"canonical\""
        }
      ]
    }
  ]
}
