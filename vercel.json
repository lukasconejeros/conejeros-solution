{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    {
      "source": "/",
      "has": [
        { "type": "header", "key": "accept", "value": ".*text/markdown.*" }
      ],
      "destination": "/index.md",
      "permanent": false
    }
  ],
  "rewrites": [
    { "source": "/index.md", "destination": "/llms.txt" },
    { "source": "/agendar-citas-whatsapp-dentalink", "destination": "/agendar-citas-whatsapp-dentalink.html" },
    { "source": "/confirmar-horas-whatsapp-clinica", "destination": "/confirmar-horas-whatsapp-clinica.html" },
    { "source": "/reducir-ausentismo-pacientes-clinica", "destination": "/reducir-ausentismo-pacientes-clinica.html" },
    { "source": "/precio-chatbot-ia-clinica-chile", "destination": "/precio-chatbot-ia-clinica-chile.html" },
    { "source": "/secretaria-virtual-ia-clinicas-chile", "destination": "/secretaria-virtual-ia-clinicas-chile.html" },
    { "source": "/reactivar-pacientes-inactivos-whatsapp", "destination": "/reactivar-pacientes-inactivos-whatsapp.html" },
    { "source": "/recordatorios-citas-whatsapp-clinica", "destination": "/recordatorios-citas-whatsapp-clinica.html" },
    { "source": "/waly-vs-secretaria-manual", "destination": "/waly-vs-secretaria-manual.html" }
  ],
  "headers": [
    {
      "source": "/index.md",
      "headers": [
        { "key": "Content-Type", "value": "text/markdown; charset=utf-8" }
      ]
    },
    {
      "source": "/llms.txt",
      "headers": [
        { "key": "Content-Type", "value": "text/markdown; charset=utf-8" }
      ]
    },
    {
      "source": "/",
      "headers": [
        {
          "key": "Link",
          "value": "</llms.txt>; rel=\"alternate\"; type=\"text/markdown\"; title=\"Resumen para agentes de IA\", </index.md>; rel=\"alternate\"; type=\"text/markdown\"; title=\"Home en markdown\", </sitemap.xml>; rel=\"sitemap\"; type=\"application/xml\", <https://www.conejeros-solutions.cl/>; rel=\"canonical\""
        }
      ]
    }
  ]
}
